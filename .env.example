# Required
DOMAIN=example.com
SESSION_SECRET=replace-with-long-random-string
ADMIN_BOOTSTRAP_PASSWORD=replace-me
ADMIN_BOOTSTRAP_USER=admin

# Public API hostname (one host for all services; path selects source).
# Local compose works without this — use http://localhost:9081/v1/...
# Required for compose.traefik.yaml Host rule.
PUBLIC_HOST=llm-gateway.example.com

# Local compose ports
WEB_PORT=9080
GATEWAY_PORT=9081

# Optional: seed named sources into SQLite on first start (then Web UI → Services).
# Prefer *_SOURCE (legacy *_BACKEND still works). Empty / omitted = start blank —
# add all sources in Admin → Services (recommended). Dashboard shows a setup checklist.
# CHAT_SOURCE=192.168.1.10:11535
# CHAT2_SOURCE=192.168.1.10:11435
# EMBED_SOURCE=192.168.1.10:11536
# STT_SOURCE=192.168.1.10:9000
# TTS_SOURCE=192.168.1.10:9001

# compose.traefik.yaml only
TEMP_MAX_C=30
TEMP_SENSOR_TYPE=x86_pkg_temp

# Optional: show Dashboard “Seed demo data” (usage charts polish). Default off.
# DEMO_TOOLS=1
